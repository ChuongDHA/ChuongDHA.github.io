---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '@/layouts/ArticleLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const {
  title,
  description,
  pubDate,
  updatedDate,
  cover,
  coverAlt,
  category,
  tags,
} = post.data;

// Calculate reading time
const wordCount = (post.body ?? '').split(/\s+/).length;
const readingTime = Math.ceil(wordCount / 200);

const formattedPubDate = new Intl.DateTimeFormat('vi-VN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(pubDate);

const formattedUpdDate = updatedDate
  ? new Intl.DateTimeFormat('vi-VN', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    }).format(updatedDate)
  : null;

// Related posts (same category or shared tags)
const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const relatedPosts = allPosts
  .filter((p) => p.id !== post.id)
  .filter((p) => p.data.category === category || p.data.tags.some((t) => tags.includes(t)))
  .slice(0, 2);
---

<ArticleLayout
  title={title}
  description={description}
  cover={cover}
  pubDate={pubDate}
  updatedDate={updatedDate}
  tags={tags}
>
  <article class="article-page">

      <!-- Article header -->
      <header class="article-header">
        <div class="container article-header-inner">
          <nav class="breadcrumb" aria-label="Đường dẫn">
            <a href="/post/">← Bài viết</a>
          </nav>

          <div class="article-meta">
            {category && <span class="article-category">{category}</span>}
            <time datetime={pubDate.toISOString()} class="article-date">{formattedPubDate}</time>
            <span class="article-reading-time">{readingTime} phút đọc</span>
          </div>

          <h1 class="article-title">{title}</h1>

          {description && <p class="article-excerpt">{description}</p>}

          {tags.length > 0 && (
            <div class="article-tags">
              {tags.map((tag) => (
                <span class="article-tag">{tag}</span>
              ))}
            </div>
          )}

          {formattedUpdDate && (
            <p class="article-updated">
              Cập nhật lần cuối: <time datetime={updatedDate?.toISOString()}>{formattedUpdDate}</time>
            </p>
          )}
        </div>
      </header>

      <!-- Cover image -->
      {cover && (
        <div class="article-cover container">
          <img
            src={cover}
            alt={coverAlt ?? title}
            class="article-cover-img"
            width="1200"
            height="630"
            loading="eager"
            decoding="async"
          />
        </div>
      )}

      <!-- Article content -->
      <div class="container article-body-wrap">
        <div class="article-body prose">
          <Content />
        </div>

        <!-- Share / Copy URL -->
        <div class="article-share">
          <span class="share-label">Chia sẻ bài viết</span>
          <button class="share-btn" id="copy-url-btn" aria-label="Sao chép liên kết bài viết">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
              <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
            </svg>
            Sao chép liên kết
          </button>
          <span class="copy-feedback" id="copy-feedback" aria-live="polite" hidden>✓ Đã sao chép!</span>
        </div>
      </div>

      <!-- Author / Navigation -->
      <div class="container article-footer">
        <div class="article-nav">
          <a href="/post/" class="article-nav-back btn btn-secondary">← Tất cả bài viết</a>
        </div>

        <!-- Related posts -->
        {relatedPosts.length > 0 && (
          <section class="related-posts" aria-labelledby="related-title">
            <h2 id="related-title" class="related-title">Bài viết liên quan</h2>
            <div class="related-grid">
              {relatedPosts.map((p) => (
                <a href={`/post/${p.id}/`} class="related-card">
                  <p class="related-card-title">{p.data.title}</p>
                  <p class="related-card-desc">{p.data.description}</p>
                </a>
              ))}
            </div>
          </section>
        )}
      </div>

    </article>
</ArticleLayout>

<style>
  /* Article page */
  .article-page {
    padding-bottom: 4rem;
  }

  /* Header */
  .article-header {
    background: var(--color-paper-deep);
    padding-block: clamp(2.5rem, 6vw, 4rem) 2rem;
  }

  .article-header-inner {
    max-width: 760px;
  }

  .breadcrumb {
    margin-bottom: 1.25rem;
  }

  .breadcrumb a {
    font-size: 0.875rem;
    color: var(--color-ink-soft);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .breadcrumb a:hover {
    color: var(--color-ocean);
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .article-category {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-ocean);
    background: rgba(0, 129, 167, 0.08);
    padding: 0.2rem 0.65rem;
    border-radius: 20px;
  }

  .article-date,
  .article-reading-time {
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  .article-date::before,
  .article-reading-time::before {
    content: '·';
    margin-right: 0.625rem;
    color: var(--color-border);
  }

  .article-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 400;
    line-height: 1.2;
    color: var(--color-ink);
    margin-bottom: 1rem;
  }

  .article-excerpt {
    font-size: 1.125rem;
    color: var(--color-ink-soft);
    line-height: 1.7;
    font-style: italic;
    max-width: 60ch;
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1.25rem;
  }

  .article-tag {
    font-size: 0.8125rem;
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    border: 1px solid var(--color-border);
    color: var(--color-ink-soft);
  }

  .article-updated {
    font-size: 0.8125rem;
    color: var(--color-muted);
    margin-top: 0.75rem;
    max-width: none;
  }

  /* Cover image */
  .article-cover {
    margin-block: 2rem;
  }

  .article-cover-img {
    width: 100%;
    max-width: 900px;
    margin-inline: auto;
    display: block;
    height: auto;
    border-radius: 20px;
    object-fit: cover;
  }

  /* Body */
  .article-body-wrap {
    padding-block: 2.5rem;
  }

  .article-body {
    max-width: 72ch;
  }

  /* Share */
  .article-share {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
    max-width: 72ch;
    flex-wrap: wrap;
  }

  .share-label {
    font-size: 0.875rem;
    color: var(--color-muted);
  }

  .share-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    border: 1.5px solid var(--color-border);
    border-radius: 20px;
    background: none;
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--color-ink-soft);
    cursor: pointer;
    transition: border-color var(--transition-fast), color var(--transition-fast);
  }

  .share-btn:hover {
    border-color: var(--color-ocean);
    color: var(--color-ocean);
  }

  .copy-feedback {
    font-size: 0.875rem;
    color: var(--color-jade);
    font-weight: 500;
  }

  /* Article footer */
  .article-footer {
    padding-block: 2rem 1rem;
  }

  .article-nav {
    margin-bottom: 3rem;
  }

  /* Related */
  .related-title {
    font-size: 1.25rem;
    margin-bottom: 1.25rem;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem;
  }

  .related-card {
    padding: 1.5rem;
    background: var(--color-paper-deep);
    border-radius: 20px;
    border: 1px solid var(--color-border);
    text-decoration: none;
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .related-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-hover);
  }

  .related-card-title {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-ink);
    margin-bottom: 0.5rem;
    max-width: none;
  }

  .related-card-desc {
    font-size: 0.875rem;
    color: var(--color-ink-soft);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    max-width: none;
  }
</style>

<script>
  // Copy URL to clipboard
  const copyBtn = document.getElementById('copy-url-btn');
  const copyFeedback = document.getElementById('copy-feedback');

  copyBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(window.location.href);
      if (copyFeedback) {
        copyFeedback.hidden = false;
        setTimeout(() => { copyFeedback.hidden = true; }, 2500);
      }
    } catch {
      // Fallback: select the URL
      const input = document.createElement('input');
      input.value = window.location.href;
      document.body.appendChild(input);
      input.select();
      document.execCommand('copy');
      document.body.removeChild(input);
      if (copyFeedback) {
        copyFeedback.hidden = false;
        setTimeout(() => { copyFeedback.hidden = true; }, 2500);
      }
    }
  });
</script>
