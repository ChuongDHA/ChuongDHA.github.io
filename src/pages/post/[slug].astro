---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '@/layouts/ArticleLayout.astro';
import PostCard from '@/components/ui/PostCard.astro';
import ArrowIcon from '@/components/ui/icons/ArrowIcon.astro';
import Spark from '@/components/ui/icons/Spark.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const {
  title,
  description,
  pubDate,
  updatedDate,
  cover,
  coverAlt,
  category,
  tags = [],
} = post.data;

// Calculate reading time
const wordCount = (post.body ?? '').split(/\s+/).length;
const readingTime = Math.ceil(wordCount / 200);

const formattedPubDate = new Intl.DateTimeFormat('vi-VN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(pubDate);

const formattedUpdDate = updatedDate
  ? new Intl.DateTimeFormat('vi-VN', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    }).format(updatedDate)
  : null;

// Related posts
const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const relatedPosts = allPosts
  .filter((p) => p.id !== post.id)
  .filter((p) => p.data.category === category || p.data.tags.some((t) => tags.includes(t)))
  .slice(0, 2);
---

<ArticleLayout
  title={title}
  description={description}
  cover={cover}
  pubDate={pubDate}
  updatedDate={updatedDate}
  tags={tags}
>
  <article class="article-page route-page">

    <!-- Article Header -->
    <header class="article-header">
      <div class="container article-header-inner">
        <nav class="breadcrumb" aria-label="Đường dẫn">
          <a href="/post/">
            <ArrowIcon />
            <span>Tất cả bài viết</span>
          </a>
        </nav>

        <div class="article-meta">
          {category && <span class="article-category">{category}</span>}
          <time datetime={pubDate.toISOString()} class="article-date">{formattedPubDate}</time>
          <span class="article-reading-time">· {readingTime} phút đọc</span>
        </div>

        <h1 class="article-title">{title}</h1>

        {description && <p class="article-excerpt">{description}</p>}

        {tags.length > 0 && (
          <div class="article-tags">
            {tags.map((tag) => (
              <span class="article-tag">#{tag}</span>
            ))}
          </div>
        )}

        {formattedUpdDate && (
          <p class="article-updated">
            Cập nhật lần cuối: <time datetime={updatedDate?.toISOString()}>{formattedUpdDate}</time>
          </p>
        )}
      </div>
    </header>

    <!-- Cover Image -->
    {cover && (
      <div class="container article-cover-wrap">
        <div class="article-cover-frame">
          <img
            src={cover}
            alt={coverAlt ?? title}
            class="article-cover-img"
            width="1200"
            height="630"
            loading="eager"
            decoding="async"
          />
        </div>
      </div>
    )}

    <!-- Article Body -->
    <div class="container article-body-container">
      <div class="article-content prose">
        <Content />
      </div>

      <!-- Share Bar -->
      <div class="article-share-bar">
        <div class="share-info">
          <Spark class="share-spark" />
          <span>Chia sẻ bài viết</span>
        </div>
        <div class="share-actions">
          <button class="button button-secondary share-btn" id="copy-url-btn" type="button" aria-label="Sao chép liên kết bài viết">
            <span>Sao chép liên kết</span>
            <ArrowIcon diagonal />
          </button>
          <span class="copy-toast" id="copy-toast" aria-live="polite" hidden>Đã sao chép!</span>
        </div>
      </div>

      <!-- Back to all posts -->
      <div class="article-back-nav">
        <a href="/post/" class="button button-light">
          <ArrowIcon />
          <span>Quay lại trang Nhật ký</span>
        </a>
      </div>

      <!-- Related Posts -->
      {relatedPosts.length > 0 && (
        <section class="related-section" aria-labelledby="related-heading">
          <h2 id="related-heading" class="related-heading">Bài viết liên quan</h2>
          <div class="related-grid">
            {relatedPosts.map((p) => (
              <PostCard
                title={p.data.title}
                description={p.data.description}
                cover={p.data.cover}
                coverAlt={p.data.coverAlt}
                category={p.data.category}
                tags={p.data.tags}
                pubDate={p.data.pubDate}
                slug={p.id}
                readingTime={Math.ceil((p.body ?? '').split(/\s+/).length / 200)}
              />
            ))}
          </div>
        </section>
      )}
    </div>

  </article>
</ArticleLayout>

<script is:inline>
  (function() {
    const copyBtn = document.getElementById('copy-url-btn');
    const toast = document.getElementById('copy-toast');

    if (copyBtn && toast) {
      copyBtn.addEventListener('click', async function() {
        const url = window.location.href;
        try {
          if (navigator.clipboard && navigator.clipboard.writeText) {
            await navigator.clipboard.writeText(url);
          } else {
            const input = document.createElement('textarea');
            input.value = url;
            input.style.position = 'fixed';
            input.style.opacity = '0';
            document.body.appendChild(input);
            input.focus();
            input.select();
            document['execCommand']('copy');
            document.body.removeChild(input);
          }
          toast.hidden = false;
          setTimeout(() => {
            toast.hidden = true;
          }, 2400);
        } catch (e) {
          toast.textContent = 'Không thể sao chép';
          toast.hidden = false;
        }
      });
    }
  })();
</script>

<style>
  .article-page {
    padding-top: 100px;
    padding-bottom: clamp(60px, 8vw, 100px);
  }

  .article-header {
    padding: clamp(32px, 5vw, 64px) 0;
    border-bottom: var(--border-width) solid var(--border-color);
    background:
      radial-gradient(circle at 80% 20%, rgba(0, 175, 185, 0.12), transparent 30%),
      var(--bg-surface-alt);
  }

  .article-header-inner {
    max-width: 820px;
  }

  .breadcrumb {
    margin-bottom: 24px;
  }

  .breadcrumb a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-ocean);
    transition: transform var(--transition-fast), color var(--transition-fast);
  }

  .breadcrumb a:hover {
    transform: translateX(-4px);
    color: var(--color-jade);
  }

  [data-theme="dark"] .breadcrumb a {
    color: var(--color-jade);
  }

  .breadcrumb a :global(svg) {
    transform: rotate(180deg);
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 16px;
    font-size: 12px;
    font-weight: 600;
    color: var(--text-muted);
  }

  .article-category {
    padding: 5px 12px;
    border: var(--border-width) solid var(--border-strong);
    border-radius: 999px;
    background: var(--color-parchment);
    color: var(--color-ink);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  [data-theme="dark"] .article-category {
    background: var(--color-jade);
    color: var(--color-ink);
    border-color: rgba(255, 255, 255, 0.4);
  }

  .article-title {
    font-family: var(--font-display);
    font-size: clamp(32px, 4.5vw, 56px);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.04em;
    margin-bottom: 18px;
  }

  .article-excerpt {
    font-size: clamp(15px, 1.6vw, 18px);
    line-height: 1.65;
    color: var(--text-secondary);
    font-style: italic;
    margin-bottom: 20px;
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .article-tag {
    font-size: 11px;
    font-weight: 600;
    color: var(--text-muted);
  }

  .article-updated {
    font-size: 11px;
    color: var(--text-muted);
    margin-top: 14px;
    font-style: italic;
  }

  .article-cover-wrap {
    margin-top: clamp(32px, 5vw, 56px);
    max-width: 900px;
  }

  .article-cover-frame {
    overflow: hidden;
    border: var(--border-width) solid var(--border-strong);
    border-radius: 28px;
    box-shadow: var(--shadow-card);
  }

  .article-cover-img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .article-body-container {
    max-width: 820px;
    margin-top: clamp(40px, 6vw, 64px);
  }

  /* Prose typography styling */
  .article-content {
    font-size: 16px;
    line-height: 1.8;
    color: var(--text-primary);
  }

  .article-content :global(h2),
  .article-content :global(h3),
  .article-content :global(h4) {
    font-family: var(--font-display);
    margin-top: 2em;
    margin-bottom: 0.8em;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .article-content :global(h2) {
    font-size: clamp(26px, 3.2vw, 36px);
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 10px;
  }

  .article-content :global(h3) {
    font-size: clamp(22px, 2.5vw, 28px);
  }

  .article-content :global(p) {
    margin-bottom: 1.5em;
    color: var(--text-primary);
  }

  .article-content :global(ul),
  .article-content :global(ol) {
    margin-bottom: 1.6em;
    padding-left: 1.5em;
  }

  .article-content :global(li) {
    margin-bottom: 0.5em;
    color: var(--text-primary);
  }

  .article-content :global(blockquote) {
    margin: 2em 0;
    padding: 18px 24px;
    border-left: 4px solid var(--color-ocean);
    background: var(--bg-surface-alt);
    border-radius: 0 16px 16px 0;
    font-style: italic;
  }

  [data-theme="dark"] .article-content :global(blockquote) {
    border-left-color: var(--color-jade);
  }

  .article-content :global(code) {
    padding: 3px 7px;
    border-radius: 6px;
    font-size: 13.5px;
    background: rgba(0, 129, 167, 0.08);
    color: var(--color-ocean);
  }

  [data-theme="dark"] .article-content :global(code) {
    background: rgba(0, 175, 185, 0.15);
    color: var(--color-jade);
  }

  .article-content :global(pre) {
    margin: 2em 0;
    padding: 20px 24px;
    border-radius: 18px;
    background: var(--color-ink);
    color: var(--color-white);
    border: var(--border-width) solid var(--border-strong);
    overflow-x: auto;
  }

  .article-content :global(pre code) {
    padding: 0;
    background: none;
    color: inherit;
    font-size: 13.5px;
  }

  .article-share-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 56px;
    padding: 24px 28px;
    border: var(--border-width) solid var(--border-strong);
    border-radius: 22px;
    background: var(--bg-surface-alt);
    box-shadow: var(--shadow-card);
  }

  .share-info {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 700;
  }

  .share-spark {
    width: 22px;
    height: 22px;
    color: var(--color-jade);
  }

  .share-actions {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .copy-toast {
    font-size: 12px;
    font-weight: 700;
    color: var(--color-jade);
  }

  .article-back-nav {
    margin-top: 40px;
  }

  .article-back-nav .button :global(svg) {
    transform: rotate(180deg);
  }

  .related-section {
    margin-top: 64px;
    padding-top: 48px;
    border-top: var(--border-width) solid var(--border-color);
  }

  .related-heading {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 700;
    margin-bottom: 24px;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
  }
</style>
