---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteHeader from '@/components/layout/SiteHeader.astro';
import SiteFooter from '@/components/layout/SiteFooter.astro';
import SectionLabel from '@/components/ui/SectionLabel.astro';
import ArrowIcon from '@/components/ui/icons/ArrowIcon.astro';
import Spark from '@/components/ui/icons/Spark.astro';
import Flower from '@/components/ui/icons/Flower.astro';
---

<BaseLayout
  title="404 — Trang không tồn tại"
  description="Trang bạn đang tìm kiếm không tồn tại hoặc đã được chuyển hướng."
>
  <SiteHeader />

  <main id="main-content" class="not-found-page route-page">
    <div class="container not-found-inner">

      <!-- Stylized Heritage Artwork -->
      <div class="not-found-art-col" aria-hidden="true">
        <div class="art-card">
          <Flower class="art-flower" />
          <div class="art-number">
            <span>4</span>
            <em>0</em>
            <span>4</span>
          </div>
          <Spark class="art-spark" />
          <p class="art-sub">Vạn vật tuần hoàn</p>
        </div>
      </div>

      <!-- Content -->
      <div class="not-found-content-col">
        <SectionLabel index="404">Lạc bước</SectionLabel>

        <h1 class="editorial-title">
          Trang không
          <br />
          <em>tồn tại.</em>
        </h1>

        <p class="not-found-desc">
          Trang bạn đang tìm kiếm có thể đã được dời đi, đổi tên hoặc chưa bao giờ tồn tại trong không gian này. Hãy quay lại trang chủ hoặc khám phá các bài viết học tập.
        </p>

        <div class="not-found-actions">
          <a href="/" class="button button-primary">
            <span>Về trang chủ</span>
            <ArrowIcon />
          </a>
          <a href="/post/" class="button button-secondary">
            <span>Xem nhật ký</span>
            <ArrowIcon diagonal />
          </a>
        </div>
      </div>

    </div>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .not-found-page {
    min-height: calc(100vh - 100px);
    display: flex;
    align-items: center;
    padding: 130px 0 80px;
    background:
      radial-gradient(circle at 75% 35%, rgba(0, 175, 185, 0.16), transparent 30%),
      radial-gradient(circle at 20% 70%, rgba(254, 217, 183, 0.3), transparent 30%),
      var(--bg-primary);
  }

  .not-found-inner {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: clamp(40px, 8vw, 90px);
    align-items: center;
  }

  .art-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 400px;
    padding: 32px;
    border: 1px solid var(--border-color);
    border-radius: 36px;
    background:
      radial-gradient(circle at center, rgba(255, 255, 255, 0.25), transparent 45%),
      linear-gradient(145deg, var(--color-ocean), var(--color-jade));
    box-shadow: var(--shadow-card);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .art-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 48px rgba(0, 129, 167, 0.25);
  }

  [data-theme="dark"] .art-card {
    border-color: rgba(255, 255, 255, 0.2);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.4);
  }

  [data-theme="dark"] .art-card:hover {
    box-shadow: 0 20px 48px rgba(0, 175, 185, 0.35);
  }

  .art-flower {
    position: absolute;
    top: 5%;
    left: 8%;
    width: 120px;
    height: 120px;
    color: var(--color-parchment);
    opacity: 0.85;
    transform: rotate(-15deg);
    transition: transform 800ms ease;
  }

  .art-card:hover .art-flower {
    transform: rotate(15deg) scale(1.1);
  }

  .art-spark {
    position: absolute;
    bottom: 12%;
    right: 10%;
    width: 36px;
    height: 36px;
    color: var(--color-terracotta);
    transition: transform 600ms ease;
  }

  .art-card:hover .art-spark {
    transform: rotate(45deg) scale(1.2);
  }

  .art-number {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: baseline;
    font-family: var(--font-display);
    font-size: clamp(80px, 11vw, 130px);
    font-weight: 800;
    line-height: 1;
    color: var(--color-white);
    letter-spacing: -0.06em;
    text-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
  }

  .art-number em {
    font-style: italic;
    color: var(--color-white);
    transform: translateY(-8px);
  }

  .art-sub {
    position: relative;
    z-index: 2;
    margin-top: 18px;
    padding: 5px 14px;
    border-radius: 999px;
    background: var(--color-white);
    color: var(--color-ink);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .editorial-title {
    font-family: var(--font-display);
    font-size: clamp(40px, 5.5vw, 76px);
    font-weight: 800;
    letter-spacing: -0.06em;
    line-height: 0.95;
    margin-bottom: 20px;
  }

  .editorial-title em {
    color: var(--color-ocean);
    font-weight: 600;
  }

  [data-theme="dark"] .editorial-title em {
    color: var(--color-jade);
  }

  .not-found-desc {
    font-size: 15px;
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 52ch;
    margin-bottom: 32px;
  }

  .not-found-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  @media (max-width: 900px) {
    .not-found-inner {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 50px;
    }

    .art-card {
      max-width: 340px;
      margin-inline: auto;
    }

    .not-found-desc {
      margin-inline: auto;
    }

    .not-found-actions {
      justify-content: center;
    }
  }

  @media (max-width: 640px) {
    .not-found-page {
      padding-top: 110px;
    }

    .not-found-actions {
      flex-direction: column;
    }

    .not-found-actions .button {
      width: 100%;
    }
  }
</style>
