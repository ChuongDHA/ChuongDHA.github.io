---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteHeader from '@/components/layout/SiteHeader.astro';
import SiteFooter from '@/components/layout/SiteFooter.astro';
import PostCard from '@/components/ui/PostCard.astro';
import ProjectCard from '@/components/ui/ProjectCard.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Reveal from '@/components/effects/Reveal.astro';
import { getCollection } from 'astro:content';
import { portfolio } from '@/data/portfolio';

// Get published posts sorted by date, take latest 3
const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const recentPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

// Calculate reading time helper
function getReadingTime(body: string): number {
  const words = body.split(/\s+/).length;
  return Math.ceil(words / 200);
}
---

<BaseLayout>
  <SiteHeader />

  <main id="main-content">

    <!-- ===== HERO ===== -->
    <section class="hero section">
      <div class="container hero-inner">
        <div class="hero-content">
          <p class="hero-eyebrow">Phân hiệu Cà Mau · Niên khóa 2024–2028</p>
          <h1 class="hero-title">
            {portfolio.name}
            <em class="hero-title-em">{portfolio.role}</em>
          </h1>
          <p class="hero-desc">{portfolio.intro}</p>
          <div class="hero-actions">
            <a href="/about/" class="btn btn-primary">Khám phá hành trình</a>
            <a href="/contact/" class="btn btn-secondary">Liên hệ</a>
          </div>
        </div>

        <!-- Hero artwork -->
        <div class="hero-visual" aria-hidden="true">
          <div class="hero-artwork">
            <!-- Abstract Asian-inspired SVG artwork -->
            <svg viewBox="0 0 420 420" fill="none" xmlns="http://www.w3.org/2000/svg" class="hero-svg">
              <!-- Outer circle -->
              <circle cx="210" cy="210" r="180" stroke="var(--color-jade)" stroke-width="1" opacity="0.3"/>
              <!-- Inner decorative elements -->
              <circle cx="210" cy="210" r="120" stroke="var(--color-ocean)" stroke-width="0.75" opacity="0.2"/>
              <!-- Wave-like path (water motif) -->
              <path d="M60 210 Q105 160 150 210 Q195 260 240 210 Q285 160 330 210 Q360 240 375 210"
                stroke="var(--color-jade)" stroke-width="1.5" fill="none" opacity="0.6"
                stroke-linecap="round"/>
              <path d="M60 230 Q105 180 150 230 Q195 280 240 230 Q285 180 330 230 Q360 258 375 230"
                stroke="var(--color-ocean)" stroke-width="1" fill="none" opacity="0.4"
                stroke-linecap="round"/>
              <!-- Lotus-inspired center -->
              <ellipse cx="210" cy="210" rx="40" ry="55" stroke="var(--color-terracotta)" stroke-width="1" opacity="0.4" transform="rotate(0 210 210)"/>
              <ellipse cx="210" cy="210" rx="40" ry="55" stroke="var(--color-terracotta)" stroke-width="1" opacity="0.3" transform="rotate(45 210 210)"/>
              <ellipse cx="210" cy="210" rx="40" ry="55" stroke="var(--color-terracotta)" stroke-width="1" opacity="0.3" transform="rotate(90 210 210)"/>
              <ellipse cx="210" cy="210" rx="40" ry="55" stroke="var(--color-terracotta)" stroke-width="1" opacity="0.3" transform="rotate(135 210 210)"/>
              <!-- Center dot -->
              <circle cx="210" cy="210" r="8" fill="var(--color-ocean)" opacity="0.6"/>
              <circle cx="210" cy="210" r="4" fill="var(--color-jade)"/>
              <!-- Corner decorative dots -->
              <circle cx="80" cy="80" r="3" fill="var(--color-parchment)" opacity="0.8"/>
              <circle cx="340" cy="80" r="3" fill="var(--color-parchment)" opacity="0.8"/>
              <circle cx="80" cy="340" r="3" fill="var(--color-parchment)" opacity="0.8"/>
              <circle cx="340" cy="340" r="3" fill="var(--color-parchment)" opacity="0.8"/>
            </svg>
          </div>
        </div>
      </div>

      <!-- Hero gradient accent line -->
      <div class="hero-accent" aria-hidden="true"></div>
    </section>

    <!-- ===== SIGNATURE / INTRO ===== -->
    <section class="intro-section section">
      <div class="container intro-inner">
        <Reveal delay={100}>
          <div class="intro-quote-mark" aria-hidden="true">"</div>
          <p class="intro-text">{portfolio.personalStory}</p>
          <a href="/about/" class="intro-link">Đọc thêm về tôi →</a>
        </Reveal>
      </div>
    </section>

    <!-- ===== SELECTED WORKS ===== -->
    <section class="works-section section">
      <div class="container">
        <Reveal>
          <SectionHeading
            eyebrow="Hành trình học tập"
            title="Dự án & Sản phẩm thực hành"
            description="Các đồ án môn học và sản phẩm thực hành sẽ được cập nhật trong quá trình theo học."
          />
        </Reveal>

        <div class="works-grid">
          {portfolio.selectedProjects.map((project, i) => (
            <Reveal delay={i * 120}>
              <ProjectCard
                title={project.title}
                description={project.description}
                tags={project.tags as unknown as string[]}
                href={project.href}
                variant={i % 2 === 0 ? 'default' : 'dark'}
              />
            </Reveal>
          ))}

          <!-- Placeholder if no projects -->
          {(portfolio.selectedProjects as readonly unknown[]).length === 0 && (
            <div class="works-placeholder">
              <p>Hành trình học tập đang diễn ra. Các dự án và sản phẩm thực hành sẽ được cập nhật liên tục tại đây.</p>
            </div>
          )}
        </div>
      </div>
    </section>

    <!-- ===== ABOUT PREVIEW ===== -->
    <section class="about-preview section">
      <div class="container about-preview-inner">
        <!-- Decorative block -->
        <Reveal delay={100} class="about-preview-visual">
          <div class="about-preview-artwork" aria-hidden="true">
            <svg viewBox="0 0 320 320" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="20" y="20" width="280" height="280" rx="32" fill="var(--color-paper-deep)"/>
              <path d="M60 200 Q100 120 160 160 Q220 200 260 120"
                stroke="var(--color-jade)" stroke-width="2" fill="none" opacity="0.7" stroke-linecap="round"/>
              <circle cx="160" cy="160" r="50" stroke="var(--color-ocean)" stroke-width="1" opacity="0.25"/>
              <circle cx="160" cy="110" r="15" fill="var(--color-parchment)" opacity="0.8"/>
              <rect x="120" y="200" width="80" height="60" rx="12" fill="var(--color-terracotta)" opacity="0.15"/>
              <text x="160" y="237" text-anchor="middle" font-family="serif" font-size="14" fill="var(--color-terracotta)" opacity="0.6">CHA</text>
            </svg>
          </div>
        </Reveal>

        <Reveal delay={200} class="about-preview-content">
          <p class="eyebrow-label">Về tôi</p>
          <h2 class="about-preview-title">Câu chuyện và định hướng</h2>
          <p class="about-preview-desc">
            {portfolio.intro}
          </p>
          <div class="about-preview-values">
            {portfolio.values.slice(0, 2).map((v) => (
              <div class="value-item">
                <span class="value-dot" aria-hidden="true"></span>
                <span>{v.title}</span>
              </div>
            ))}
          </div>
          <a href="/about/" class="btn btn-secondary about-preview-cta">Khám phá thêm</a>
        </Reveal>
      </div>
    </section>

    <!-- ===== FEATURED POSTS ===== -->
    {recentPosts.length > 0 && (
      <section class="posts-section section">
        <div class="container">
          <SectionHeading
            eyebrow="Bài viết gần đây"
            title="Chia sẻ & Suy nghĩ"
            description="Những ghi chép, kinh nghiệm và góc nhìn từ hành trình của tôi."
          />

          <div class="posts-grid">
            {recentPosts.map((post) => (
              <PostCard
                title={post.data.title}
                description={post.data.description}
                cover={post.data.cover}
                coverAlt={post.data.coverAlt}
                category={post.data.category}
                tags={post.data.tags}
                pubDate={post.data.pubDate}
                slug={post.id}
                featured={post.data.featured}
                readingTime={getReadingTime(post.body ?? '')}
              />
            ))}
          </div>

          <div class="posts-more">
            <a href="/post/" class="btn btn-secondary">Xem tất cả bài viết</a>
          </div>
        </div>
      </section>
    )}

    <!-- ===== CLOSING CTA ===== -->
    <section class="cta-section">
      <div class="container">
        <div class="cta-inner">
          <div class="cta-decoration" aria-hidden="true">
            <svg viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M100 20 L180 100 L100 180 L20 100 Z" stroke="white" stroke-width="1" opacity="0.2" fill="none"/>
              <circle cx="100" cy="100" r="40" stroke="white" stroke-width="1" opacity="0.15"/>
            </svg>
          </div>
          <p class="cta-eyebrow">Đồng hành & Kết nối</p>
          <h2 class="cta-title">Cùng trao đổi và chia sẻ kiến thức</h2>
          <p class="cta-desc">Mình luôn sẵn lòng kết nối cùng thầy cô, bạn bè và những người quan tâm đến công nghệ.</p>
          <a href="/contact/" class="btn cta-btn">Liên hệ với mình →</a>
        </div>
      </div>
    </section>

  </main>

  <SiteFooter />
</BaseLayout>

<style>
  /* ===== HERO ===== */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(4rem, 10vw, 7rem);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .hero-eyebrow {
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-jade);
    max-width: none;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    font-weight: 400;
    line-height: 1.15;
    color: var(--color-ink);
  }

  .hero-title-em {
    display: block;
    font-style: italic;
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-desc {
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--color-ink-soft);
    max-width: 52ch;
  }

  .hero-actions {
    display: flex;
    gap: 0.875rem;
    flex-wrap: wrap;
    padding-top: 0.5rem;
  }

  /* Hero visual */
  .hero-visual {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hero-artwork {
    width: clamp(240px, 40vw, 380px);
    height: clamp(240px, 40vw, 380px);
    background: var(--color-paper-deep);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    animation: hero-float 6s ease-in-out infinite;
  }

  .hero-svg {
    width: 100%;
    height: 100%;
    animation: hero-rotate 40s linear infinite;
  }

  .hero-accent {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--gradient-primary);
    opacity: 0.6;
  }

  @keyframes hero-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-12px); }
  }

  @keyframes hero-rotate {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-artwork, .hero-svg { animation: none; }
  }

  /* ===== INTRO SECTION ===== */
  .intro-section {
    background: var(--color-paper-deep);
    padding-block: 4rem;
  }

  .intro-inner {
    max-width: 760px;
    margin-inline: auto;
    text-align: center;
    position: relative;
  }

  .intro-quote-mark {
    font-family: var(--font-display);
    font-size: 8rem;
    line-height: 0.6;
    color: var(--color-jade);
    opacity: 0.2;
    margin-bottom: -1rem;
    font-style: italic;
    user-select: none;
  }

  .intro-text {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2.2vw, 1.375rem);
    line-height: 1.75;
    color: var(--color-ink);
    font-style: italic;
    max-width: none;
    margin-bottom: 1.5rem;
  }

  .intro-link {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-ocean);
    text-decoration: none;
    transition: color var(--transition-fast), gap var(--transition-fast);
  }

  .intro-link:hover {
    color: var(--color-jade);
  }

  /* ===== WORKS SECTION ===== */
  .works-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .works-placeholder {
    grid-column: 1 / -1;
    padding: 3rem;
    background: var(--color-paper-deep);
    border-radius: var(--radius-card);
    text-align: center;
    color: var(--color-muted);
    border: 1px dashed var(--color-border);
  }

  /* ===== ABOUT PREVIEW ===== */
  .about-preview {
    background: var(--color-paper-deep);
  }

  .about-preview-inner {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 4rem;
    align-items: center;
  }

  .about-preview-visual {
    display: flex;
    justify-content: center;
  }

  .about-preview-artwork {
    width: 100%;
    max-width: 320px;
    border-radius: var(--radius-card);
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }

  .about-preview-artwork svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .about-preview-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .eyebrow-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-jade);
    max-width: none;
  }

  .about-preview-title {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
  }

  .about-preview-desc {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-ink-soft);
    max-width: none;
  }

  .about-preview-values {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-block: 0.25rem;
  }

  .value-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.9375rem;
    color: var(--color-ink-soft);
  }

  .value-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--gradient-primary);
    flex-shrink: 0;
  }

  /* ===== POSTS SECTION ===== */
  .posts-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .posts-more {
    margin-top: 2.5rem;
    display: flex;
    justify-content: center;
  }

  /* ===== CTA SECTION ===== */
  .cta-section {
    padding-block: 5rem;
  }

  .cta-inner {
    position: relative;
    background: var(--gradient-primary);
    border-radius: var(--radius-card);
    padding: clamp(2.5rem, 6vw, 4.5rem) clamp(2rem, 5vw, 4rem);
    text-align: center;
    color: white;
    overflow: hidden;
  }

  .cta-decoration {
    position: absolute;
    top: -40px;
    right: -40px;
    width: 200px;
    height: 200px;
    pointer-events: none;
  }

  .cta-eyebrow {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    opacity: 0.7;
    margin-bottom: 0.75rem;
    max-width: none;
    color: white;
  }

  .cta-title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.5vw, 2.5rem);
    font-weight: 400;
    color: white;
    margin-bottom: 0.875rem;
  }

  .cta-desc {
    font-size: 1.0625rem;
    opacity: 0.85;
    max-width: 52ch;
    margin-inline: auto;
    color: white;
    margin-bottom: 2rem;
  }

  .cta-btn {
    background: white;
    color: var(--color-ocean);
    font-weight: 700;
  }

  .cta-btn:hover {
    background: rgba(255,255,255,0.92);
  }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 1024px) {
    .posts-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .hero-visual {
      order: -1;
    }

    .hero-artwork {
      width: 220px;
      height: 220px;
    }

    .about-preview-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .posts-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
