---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteHeader from '@/components/layout/SiteHeader.astro';
import SiteFooter from '@/components/layout/SiteFooter.astro';
import SectionLabel from '@/components/ui/SectionLabel.astro';
import OrnamentalWing from '@/components/ui/icons/OrnamentalWing.astro';
import Spark from '@/components/ui/icons/Spark.astro';
import ArrowIcon from '@/components/ui/icons/ArrowIcon.astro';
import { portfolio } from '@/data/portfolio';

const hasFormEndpoint = Boolean(portfolio.formEndpoint);
---

<BaseLayout
  title="Liên hệ"
  description={`Kết nối và trao đổi với ${portfolio.name} — Sinh viên Công nghệ thông tin Phân hiệu Cà Mau.`}
>
  <SiteHeader />

  <main id="main-content" class="route-page">

    <section class="contact-section" id="contact">
      <!-- Background Ornamental Wings -->
      <OrnamentalWing class="contact-wing-left" />
      <OrnamentalWing flip class="contact-wing-right" />

      <div class="container contact-container">

        <!-- Column 1: Heading & Info -->
        <div class="contact-info-col">
          <SectionLabel index="04">Kết nối</SectionLabel>

          <h1 class="editorial-title">
            Cùng bắt đầu một
            <br />
            <em>cuộc trò chuyện.</em>
          </h1>

          <p class="contact-lead">
            Nếu bạn muốn chia sẻ một ý tưởng, trao đổi về công nghệ, hoặc chỉ đơn giản là nói lời chào, mình luôn sẵn lòng đón nhận những chia sẻ từ thầy cô, bạn bè và cộng đồng.
          </p>

          <div class="contact-cards">
            <!-- Email Block -->
            <div class="contact-detail-card">
              <span class="detail-label">Email liên hệ</span>
              <div class="email-row">
                <a href={`mailto:${portfolio.email}`} class="detail-value email-link">
                  {portfolio.email}
                </a>
                <button
                  type="button"
                  id="copy-email-btn"
                  class="copy-icon-btn"
                  aria-label="Sao chép email"
                  title="Sao chép địa chỉ email"
                >
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                  </svg>
                </button>
                <span class="copy-toast" id="email-toast" aria-live="polite" hidden>Đã sao chép!</span>
              </div>
            </div>

            <!-- Education Block -->
            <div class="contact-detail-card">
              <span class="detail-label">Đơn vị & Nơi học</span>
              <p class="detail-value">{portfolio.institution} · {portfolio.location}</p>
              <span class="detail-sub">{portfolio.major} — Niên khóa {portfolio.academicYears}</span>
            </div>

            <!-- Social / GitHub Block -->
            <div class="contact-detail-card">
              <span class="detail-label">Mã nguồn & Kết nối</span>
              <a href="https://github.com/ChuongDHA" target="_blank" rel="noopener noreferrer" class="social-chip">
                <span>GitHub · ChuongDHA</span>
                <ArrowIcon diagonal />
              </a>
            </div>
          </div>
        </div>

        <!-- Column 2: Form -->
        <div class="contact-form-col">
          <form
            id="contact-form"
            class="contact-form"
            method="POST"
            action={hasFormEndpoint ? portfolio.formEndpoint : undefined}
            data-endpoint={portfolio.formEndpoint}
            novalidate
          >
            <div class="form-header">
              <h2 class="form-title">Để lại lời nhắn</h2>
              <span class="form-badge">Trực tuyến</span>
            </div>

            <label class="form-label" for="contact-name">
              <span>Tên của bạn</span>
              <input
                id="contact-name"
                name="name"
                type="text"
                placeholder="Bạn muốn mình gọi là..."
                required
                autocomplete="name"
              />
              <span class="field-error" id="name-error"></span>
            </label>

            <label class="form-label" for="contact-email">
              <span>Email</span>
              <input
                id="contact-email"
                name="email"
                type="email"
                placeholder="hello@example.com"
                required
                autocomplete="email"
              />
              <span class="field-error" id="email-error"></span>
            </label>

            <label class="form-label" for="contact-message">
              <span>Lời nhắn</span>
              <textarea
                id="contact-message"
                name="message"
                rows="4"
                placeholder="Viết điều bạn đang nghĩ..."
                required
              ></textarea>
              <span class="field-error" id="message-error"></span>
            </label>

            <div class="form-status-msg" id="form-general-error" style="display: none;"></div>

            <!-- Success State Message -->
            <div class="success-message" id="form-success" style="display: none;">
              <Spark />
              <div>
                <strong>Đã nhận lời nhắn!</strong>
                <small>Cảm ơn bạn. Mình sẽ phản hồi qua email trong thời gian sớm nhất.</small>
              </div>
            </div>

            <button class="submit-button" id="submit-btn" type="submit">
              <span id="btn-text">Gửi lời nhắn</span>
              <ArrowIcon />
            </button>
          </form>
        </div>

      </div>
    </section>

  </main>

  <SiteFooter />
</BaseLayout>

<script is:inline>
  (function() {
    // Copy email handler with modern navigator.clipboard
    const copyBtn = document.getElementById('copy-email-btn');
    const toast = document.getElementById('email-toast');
    const emailStr = 'anhchuongcm@gmail.com';

    if (copyBtn && toast) {
      copyBtn.addEventListener('click', async function() {
        try {
          if (navigator.clipboard && navigator.clipboard.writeText) {
            await navigator.clipboard.writeText(emailStr);
          } else {
            const input = document.createElement('textarea');
            input.value = emailStr;
            input.style.position = 'fixed';
            input.style.opacity = '0';
            document.body.appendChild(input);
            input.focus();
            input.select();
            document['execCommand']('copy');
            document.body.removeChild(input);
          }
          toast.hidden = false;
          setTimeout(() => {
            toast.hidden = true;
          }, 2400);
        } catch (e) {
          toast.textContent = 'Lỗi sao chép';
          toast.hidden = false;
        }
      });
    }

    // Form interactive validation & submission
    const form = document.getElementById('contact-form');
    const nameInput = document.getElementById('contact-name');
    const emailInput = document.getElementById('contact-email');
    const messageInput = document.getElementById('contact-message');
    const nameError = document.getElementById('name-error');
    const emailError = document.getElementById('email-error');
    const messageError = document.getElementById('message-error');
    const generalError = document.getElementById('form-general-error');
    const successMsg = document.getElementById('form-success');
    const submitBtn = document.getElementById('submit-btn');
    const btnText = document.getElementById('btn-text');

    if (form) {
      form.addEventListener('submit', async function(e) {
        e.preventDefault();

        // Clear errors
        if (nameError) nameError.textContent = '';
        if (emailError) emailError.textContent = '';
        if (messageError) messageError.textContent = '';
        if (generalError) {
          generalError.style.display = 'none';
          generalError.textContent = '';
        }

        let valid = true;

        const nameVal = nameInput ? nameInput.value.trim() : '';
        const emailVal = emailInput ? emailInput.value.trim() : '';
        const messageVal = messageInput ? messageInput.value.trim() : '';

        if (!nameVal) {
          if (nameError) nameError.textContent = 'Vui lòng nhập tên của bạn.';
          valid = false;
        }

        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailVal) {
          if (emailError) emailError.textContent = 'Vui lòng nhập địa chỉ email.';
          valid = false;
        } else if (!emailRegex.test(emailVal)) {
          if (emailError) emailError.textContent = 'Định dạng email chưa hợp lệ.';
          valid = false;
        }

        if (!messageVal) {
          if (messageError) messageError.textContent = 'Vui lòng nhập nội dung lời nhắn.';
          valid = false;
        } else if (messageVal.length < 5) {
          if (messageError) messageError.textContent = 'Lời nhắn cần có ít nhất 5 ký tự.';
          valid = false;
        }

        if (!valid) return;

        // Valid form -> Handle submission
        const endpoint = form.getAttribute('data-endpoint');

        if (submitBtn) submitBtn.disabled = true;
        if (btnText) btnText.textContent = 'Đang xử lý...';

        if (endpoint && endpoint.startsWith('http')) {
          try {
            const formData = new FormData(form);
            const res = await fetch(endpoint, {
              method: 'POST',
              body: formData,
              headers: { 'Accept': 'application/json' },
            });

            if (res.ok) {
              if (successMsg) successMsg.style.display = 'flex';
              if (submitBtn) submitBtn.style.display = 'none';
              form.reset();
            } else {
              throw new Error('Endpoint error');
            }
          } catch (err) {
            // Fallback to mailto
            const mailtoUrl = `mailto:${emailStr}?subject=Liên hệ qua Portfolio từ ${encodeURIComponent(nameVal)}&body=${encodeURIComponent(messageVal + '\n\nEmail người gửi: ' + emailVal)}`;
            window.location.href = mailtoUrl;
            if (successMsg) {
              successMsg.style.display = 'flex';
              successMsg.innerHTML = '<span>Đang chuyển tiếp lời nhắn đến ứng dụng email của bạn...</span>';
            }
          }
        } else {
          // No backend endpoint configured: trigger direct mailto link
          setTimeout(() => {
            const mailtoUrl = `mailto:${emailStr}?subject=Liên hệ qua Portfolio từ ${encodeURIComponent(nameVal)}&body=${encodeURIComponent(messageVal + '\n\nEmail người gửi: ' + emailVal)}`;
            window.location.href = mailtoUrl;
            if (successMsg) successMsg.style.display = 'flex';
            if (submitBtn) submitBtn.style.display = 'none';
            form.reset();
          }, 600);
        }
      });
    }
  })();
</script>

<style>
  .contact-section {
    position: relative;
    overflow: hidden;
    padding: clamp(120px, 14vw, 160px) 0 clamp(80px, 10vw, 120px);
    background:
      radial-gradient(circle at 18% 42%, rgba(0, 175, 185, 0.1), transparent 35%),
      radial-gradient(circle at 82% 18%, rgba(254, 217, 183, 0.2), transparent 35%),
      var(--bg-primary);
  }

  [data-theme="dark"] .contact-section {
    background:
      radial-gradient(circle at 18% 42%, rgba(0, 175, 185, 0.15), transparent 35%),
      radial-gradient(circle at 82% 18%, rgba(0, 129, 167, 0.18), transparent 35%),
      var(--bg-primary);
    color: var(--text-primary);
  }

  .contact-wing-left {
    bottom: -220px;
    left: -120px;
    width: 380px;
    color: var(--color-jade);
    opacity: 0.14;
    pointer-events: none;
    filter: blur(1px);
  }

  .contact-wing-right {
    top: -200px;
    right: -140px;
    width: 380px;
    color: var(--color-ocean);
    opacity: 0.14;
    pointer-events: none;
    filter: blur(1px);
  }

  [data-theme="dark"] .contact-wing-left,
  [data-theme="dark"] .contact-wing-right {
    opacity: 0.18;
  }

  .contact-container {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: 1.15fr 0.95fr;
    gap: clamp(40px, 7vw, 100px);
    align-items: start;
  }

  .editorial-title {
    font-family: var(--font-display);
    font-size: clamp(40px, 5.5vw, 76px);
    font-weight: 800;
    letter-spacing: -0.06em;
    line-height: 0.92;
    margin-bottom: 24px;
    color: var(--text-primary);
  }

  .editorial-title em {
    color: var(--color-ocean);
    font-weight: 600;
  }

  [data-theme="dark"] .editorial-title em {
    color: var(--color-jade);
  }

  .contact-lead {
    font-size: 15px;
    line-height: 1.7;
    margin-bottom: 36px;
    max-width: 54ch;
    color: var(--text-secondary);
  }

  .contact-cards {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .contact-detail-card {
    padding: 20px 24px;
    border: 1px solid var(--border-color);
    border-radius: 20px;
    background: var(--bg-surface);
    box-shadow: var(--shadow-card);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast), border-color var(--transition-fast);
  }

  .contact-detail-card:hover {
    transform: translateY(-3px);
    border-color: var(--color-ocean);
    box-shadow: 0 8px 24px rgba(0, 129, 167, 0.12);
  }

  [data-theme="dark"] .contact-detail-card:hover {
    border-color: var(--color-jade);
    box-shadow: 0 8px 24px rgba(0, 175, 185, 0.18);
  }

  .detail-label {
    display: block;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 6px;
  }

  .email-row {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .detail-value {
    font-size: 15px;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
  }

  .email-link {
    color: var(--color-ocean);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  [data-theme="dark"] .email-link {
    color: var(--color-jade);
  }

  .copy-icon-btn {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    background: var(--bg-surface-alt);
    color: var(--text-primary);
    transition: transform var(--transition-fast), background var(--transition-fast);
  }

  .copy-icon-btn:hover {
    background: var(--color-jade);
    color: var(--color-white);
    transform: scale(1.05);
  }

  .copy-toast {
    font-size: 11px;
    font-weight: 700;
    color: var(--color-jade);
  }

  .detail-sub {
    display: block;
    font-size: 12px;
    color: var(--text-muted);
    margin-top: 4px;
  }

  .social-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    color: var(--text-primary);
    background: var(--bg-surface-alt);
    transition: transform var(--transition-fast), background var(--transition-fast);
  }

  .social-chip:hover {
    background: var(--color-ocean);
    color: var(--color-white);
    transform: translateY(-2px);
  }

  [data-theme="dark"] .social-chip:hover {
    background: var(--color-jade);
    color: var(--color-ink);
  }

  /* ============================================================
     CONTACT FORM
     ============================================================ */
  .contact-form {
    padding: clamp(28px, 4vw, 42px);
    border: 1px solid var(--border-color);
    border-radius: 32px;
    background: var(--bg-surface);
    box-shadow: var(--shadow-card);
    transform: none;
    transition: box-shadow var(--transition-base), border-color var(--transition-base);
  }

  .contact-form:hover {
    box-shadow: var(--shadow-card-hover);
  }

  [data-theme="dark"] .contact-form {
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35);
  }

  [data-theme="dark"] .contact-form:hover {
    box-shadow: 0 20px 48px rgba(0, 0, 0, 0.45), 0 0 0 1px rgba(0, 175, 185, 0.3);
  }

  .form-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 28px;
  }

  .form-title {
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 700;
  }

  .form-badge {
    padding: 5px 12px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: var(--color-parchment);
    color: var(--color-ink);
  }

  [data-theme="dark"] .form-badge {
    background: var(--color-jade);
    color: var(--color-ink);
  }

  .form-label {
    display: block;
    margin-bottom: 24px;
  }

  .form-label > span:first-child {
    display: block;
    margin-bottom: 8px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-primary);
  }

  .contact-form input,
  .contact-form textarea {
    width: 100%;
    padding: 12px 0;
    border: 0;
    border-bottom: 1.5px solid var(--border-strong);
    border-radius: 0;
    outline: 0;
    background: transparent;
    color: var(--text-primary);
    font-size: 14.5px;
    line-height: 1.5;
    resize: vertical;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .contact-form input:focus,
  .contact-form textarea:focus {
    border-color: var(--color-ocean);
    box-shadow: 0 2px 0 var(--color-ocean);
  }

  [data-theme="dark"] .contact-form input:focus,
  [data-theme="dark"] .contact-form textarea:focus {
    border-color: var(--color-jade);
    box-shadow: 0 2px 0 var(--color-jade);
  }

  .contact-form input::placeholder,
  .contact-form textarea::placeholder {
    color: var(--text-muted);
  }

  .field-error {
    display: block;
    font-size: 11px;
    font-weight: 600;
    color: #e63946;
    margin-top: 6px;
    min-height: 16px;
  }

  .submit-button {
    display: flex;
    width: 100%;
    min-height: 56px;
    align-items: center;
    justify-content: space-between;
    margin-top: 24px;
    padding: 0 24px;
    border: none;
    border-radius: 17px;
    background: var(--color-ocean);
    color: var(--color-white);
    font-size: 13.5px;
    font-weight: 800;
    letter-spacing: 0.04em;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(0, 129, 167, 0.25);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast), background var(--transition-fast);
  }

  .submit-button:hover {
    background: #006c8c;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 129, 167, 0.35);
  }

  .submit-button:hover :global(svg) {
    transform: translateX(4px);
  }

  [data-theme="dark"] .submit-button {
    background: var(--color-jade);
    color: var(--color-ink);
    box-shadow: 0 4px 16px rgba(0, 175, 185, 0.35);
  }

  [data-theme="dark"] .submit-button:hover {
    background: #02c5d0;
    box-shadow: 0 8px 24px rgba(0, 175, 185, 0.5);
  }

  .submit-button:disabled {
    opacity: 0.65;
    cursor: wait;
  }

  .success-message {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 18px 20px;
    border: var(--border-width) solid var(--border-strong);
    border-radius: 18px;
    background: var(--color-parchment);
    color: var(--color-ink);
    margin-top: 16px;
  }

  .success-message :global(.spark) {
    width: 32px;
    height: 32px;
    color: var(--color-ocean);
    flex-shrink: 0;
  }

  .success-message strong {
    display: block;
    font-size: 14px;
    margin-bottom: 2px;
  }

  .success-message small {
    display: block;
    font-size: 12px;
    line-height: 1.4;
    color: rgba(21, 21, 27, 0.75);
  }

  /* ============================================================
     RESPONSIVE BREAKPOINTS
     ============================================================ */
  @media (max-width: 900px) {
    .contact-container {
      grid-template-columns: 1fr;
      gap: 50px;
    }

    .contact-form {
      transform: none;
      max-width: 600px;
      margin-inline: auto;
      width: 100%;
    }
  }

  @media (max-width: 640px) {
    .contact-section {
      padding: 110px 0 80px;
    }

    .contact-wing-left,
    .contact-wing-right {
      display: none;
    }
  }
</style>
