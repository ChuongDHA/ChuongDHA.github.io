---
import ArrowIcon from '@/components/ui/icons/ArrowIcon.astro';

interface Props {
  title: string;
  description: string;
  cover?: string;
  coverAlt?: string;
  category?: string;
  tags?: string[];
  pubDate: Date;
  slug: string;
  featured?: boolean;
  readingTime?: number;
}

const {
  title,
  description,
  cover,
  coverAlt = title,
  category,
  tags = [],
  pubDate,
  slug,
  featured = false,
  readingTime,
} = Astro.props;

const formattedDate = new Intl.DateTimeFormat('vi-VN', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
}).format(pubDate);
---

<article class:list={['post-card', { 'post-card-featured': featured }]}>
  <a href={`/post/${slug}/`} class="post-card-visual" aria-hidden="true" tabindex="-1">
    {cover ? (
      <img
        src={cover}
        alt={coverAlt}
        class="post-card-img"
        loading="lazy"
        decoding="async"
        width="600"
        height="360"
      />
    ) : (
      <div class="post-card-art-fallback">
        <svg viewBox="0 0 160 160" fill="none" class="fallback-svg">
          <circle cx="80" cy="80" r="60" stroke="var(--color-jade)" stroke-width="1.5" opacity="0.4" />
          <path d="M40 100 Q80 50 120 100" stroke="var(--color-ocean)" stroke-width="2" fill="none" />
          <circle cx="80" cy="65" r="14" fill="var(--color-parchment)" />
        </svg>
      </div>
    )}

    {category && <span class="post-card-badge">{category}</span>}
  </a>

  <div class="post-card-body">
    <div class="post-card-meta">
      <time datetime={pubDate.toISOString()} class="post-card-date">{formattedDate}</time>
      {readingTime && <span class="post-card-reading-time">· {readingTime} phút đọc</span>}
    </div>

    <h3 class="post-card-title">
      <a href={`/post/${slug}/`}>{title}</a>
    </h3>

    <p class="post-card-desc">{description}</p>

    <div class="post-card-footer">
      {tags.length > 0 && (
        <div class="post-card-tags">
          {tags.slice(0, 3).map((tag) => (
            <span class="post-tag">#{tag}</span>
          ))}
        </div>
      )}
      <a href={`/post/${slug}/`} class="post-card-read-link" aria-label={`Đọc bài viết: ${title}`}>
        <span>Đọc bài</span>
        <ArrowIcon diagonal />
      </a>
    </div>
  </div>
</article>

<style>
  .post-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: var(--border-width) solid var(--border-strong);
    border-radius: 26px;
    background: var(--bg-surface);
    box-shadow: var(--shadow-card);
    transition: transform var(--transition-base), box-shadow var(--transition-base), border-color var(--transition-base);
    height: 100%;
  }

  .post-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card-hover);
    border-color: var(--color-ocean);
  }

  [data-theme="dark"] .post-card:hover {
    border-color: var(--color-jade);
  }

  .post-card-visual {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9.5;
    overflow: hidden;
    background: var(--bg-surface-alt);
    border-bottom: var(--border-width) solid var(--border-strong);
  }

  .post-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .post-card:hover .post-card-img {
    transform: scale(1.04);
  }

  .post-card-art-fallback {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, rgba(0, 129, 167, 0.08), rgba(0, 175, 185, 0.15));
  }

  .fallback-svg {
    width: 100px;
    height: 100px;
  }

  .post-card-badge {
    position: absolute;
    top: 14px;
    left: 14px;
    padding: 6px 12px;
    border: var(--border-width) solid var(--border-strong);
    border-radius: 999px;
    background: var(--color-parchment);
    color: var(--color-ink);
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    box-shadow: 2px 2px 0 var(--border-strong);
  }

  [data-theme="dark"] .post-card-badge {
    background: var(--color-jade);
    color: var(--color-ink);
    border-color: rgba(255, 255, 255, 0.4);
    box-shadow: 2px 2px 0 rgba(0, 175, 185, 0.5);
  }

  .post-card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: clamp(20px, 3vw, 26px);
  }

  .post-card-meta {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 11.5px;
    font-weight: 600;
    color: var(--text-muted);
    margin-bottom: 10px;
  }

  .post-card-title {
    margin: 0 0 10px;
    font-family: var(--font-display);
    font-size: clamp(18px, 2.2vw, 22px);
    font-weight: 700;
    line-height: 1.3;
  }

  .post-card-title a {
    color: var(--text-primary);
    transition: color var(--transition-fast);
  }

  .post-card-title a:hover {
    color: var(--color-ocean);
  }

  [data-theme="dark"] .post-card-title a:hover {
    color: var(--color-jade);
  }

  .post-card-desc {
    margin: 0 0 18px;
    font-size: 13px;
    color: var(--text-secondary);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px solid var(--border-color);
  }

  .post-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .post-tag {
    font-size: 10.5px;
    font-weight: 600;
    color: var(--text-muted);
  }

  .post-card-read-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-ocean);
    transition: transform var(--transition-fast), color var(--transition-fast);
    flex-shrink: 0;
  }

  [data-theme="dark"] .post-card-read-link {
    color: var(--color-jade);
  }

  .post-card-read-link:hover {
    transform: translateX(3px);
  }
</style>
