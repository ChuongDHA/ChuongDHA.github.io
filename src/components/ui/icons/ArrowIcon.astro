---
interface Props {
  diagonal?: boolean;
  class?: string;
}

const { diagonal = false, class: className = '' } = Astro.props;
---

<svg
  class:list={['arrow-icon', className]}
  aria-hidden="true"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {diagonal ? (
    <path d="M7 17 17 7M8 7h9v9" />
  ) : (
    <path d="M5 12h14m-5-5 5 5-5 5" />
  )}
</svg>

<style>
  .arrow-icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    transition: transform var(--transition-fast, 180ms ease);
  }
</style>
