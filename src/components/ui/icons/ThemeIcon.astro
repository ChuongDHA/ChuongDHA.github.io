---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<span class:list={['theme-icon-wrap', className]} aria-hidden="true">
  <!-- Sun icon (shown in dark mode to switch to light) -->
  <svg class="sun-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
  </svg>
  <!-- Moon icon (shown in light mode to switch to dark) -->
  <svg class="moon-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <path d="M20.4 15.2A8.5 8.5 0 0 1 8.8 3.6 8.5 8.5 0 1 0 20.4 15.2Z" />
  </svg>
</span>

<style>
  .theme-icon-wrap {
    display: inline-grid;
    place-items: center;
    width: 20px;
    height: 20px;
    position: relative;
  }

  .theme-icon-wrap svg {
    width: 20px;
    height: 20px;
    transition: opacity var(--transition-fast, 180ms ease), transform var(--transition-fast, 180ms ease);
  }

  /* Default (Light mode): show moon, hide sun */
  .sun-icon {
    display: none;
  }
  .moon-icon {
    display: block;
  }

  /* Dark mode: show sun, hide moon */
  :global([data-theme="dark"]) .sun-icon {
    display: block;
  }
  :global([data-theme="dark"]) .moon-icon {
    display: none;
  }
</style>
