---
import ArrowIcon from '@/components/ui/icons/ArrowIcon.astro';

interface Props {
  title: string;
  description: string;
  tags?: string[];
  href?: string;
  variant?: 'default' | 'dark' | 'gradient';
}

const {
  title,
  description,
  tags = [],
  href = '#',
  variant = 'default',
} = Astro.props;
---

<article class:list={['project-card', `project-card--${variant}`]}>
  <div class="project-card-header">
    <div class="project-card-tags">
      {tags.map((tag) => <span class="project-tag">{tag}</span>)}
    </div>
  </div>

  <div class="project-card-body">
    <h3 class="project-card-title">{title}</h3>
    <p class="project-card-desc">{description}</p>

    <a href={href} class="project-card-link" aria-label={`Xem chi tiết: ${title}`}>
      <span>Xem chi tiết</span>
      <ArrowIcon diagonal />
    </a>
  </div>
</article>

<style>
  .project-card {
    position: relative;
    border-radius: 26px;
    overflow: hidden;
    padding: clamp(24px, 3.5vw, 32px);
    min-height: 260px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border: var(--border-width) solid var(--border-strong);
    box-shadow: var(--shadow-card);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .project-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card-hover);
    border-color: var(--color-ocean);
  }

  [data-theme="dark"] .project-card:hover {
    border-color: var(--color-jade);
  }

  .project-card--default {
    background: var(--bg-surface);
    color: var(--text-primary);
  }

  .project-card--dark {
    background: var(--color-ink);
    color: var(--color-white);
  }

  .project-card--dark .project-card-desc {
    color: rgba(255, 255, 255, 0.7);
  }

  .project-card--gradient {
    background: var(--gradient-warm);
    color: var(--color-ink);
  }

  .project-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 20px;
  }

  .project-tag {
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: rgba(0, 129, 167, 0.1);
    color: var(--color-ocean);
    border: 1px solid rgba(0, 129, 167, 0.2);
  }

  [data-theme="dark"] .project-tag {
    background: rgba(0, 175, 185, 0.15);
    color: var(--color-jade);
    border-color: rgba(0, 175, 185, 0.3);
  }

  .project-card-title {
    font-family: var(--font-display);
    font-size: clamp(20px, 2.5vw, 24px);
    font-weight: 700;
    margin-bottom: 8px;
  }

  .project-card-desc {
    font-size: 13.5px;
    line-height: 1.6;
    margin-bottom: 20px;
    color: var(--text-secondary);
  }

  .project-card-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-ocean);
    transition: transform var(--transition-fast), color var(--transition-fast);
  }

  [data-theme="dark"] .project-card-link {
    color: var(--color-jade);
  }

  .project-card:hover .project-card-link {
    transform: translateX(4px);
  }
</style>
