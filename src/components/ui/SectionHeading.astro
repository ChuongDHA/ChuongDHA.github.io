---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  class?: string;
}

const {
  eyebrow,
  title,
  description,
  align = 'left',
  class: className = '',
} = Astro.props;
---

<div class:list={['section-heading', `align-${align}`, className]}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 class="heading">{title}</h2>
  {description && <p class="description">{description}</p>}
</div>

<style>
  .section-heading {
    margin-bottom: 3rem;
  }

  .align-center {
    text-align: center;
  }

  .align-center .description {
    margin-inline: auto;
  }

  .eyebrow {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-jade);
    margin-bottom: 0.625rem;
    max-width: none;
  }

  .heading {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 400;
    color: var(--color-ink);
    line-height: 1.2;
    margin-bottom: 0.75rem;
  }

  .description {
    font-size: 1.0625rem;
    color: var(--color-ink-soft);
    max-width: 56ch;
    line-height: 1.7;
  }
</style>
