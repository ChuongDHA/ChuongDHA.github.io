---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  class?: string;
}

const {
  eyebrow,
  title,
  description,
  align = 'left',
  class: className = '',
} = Astro.props;
---

<div class:list={['section-heading', `align-${align}`, className]}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 class="heading" set:html={title} />
  {description && <p class="description">{description}</p>}
</div>

<style>
  .section-heading {
    margin-bottom: clamp(32px, 5vw, 56px);
  }

  .align-center {
    text-align: center;
  }

  .align-center .description {
    margin-inline: auto;
  }

  .eyebrow {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-ocean);
    margin-bottom: 8px;
  }

  [data-theme="dark"] .eyebrow {
    color: var(--color-jade);
  }

  .heading {
    font-family: var(--font-display);
    font-size: clamp(32px, 4.5vw, 56px);
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1.05;
    letter-spacing: -0.04em;
    margin-bottom: 12px;
  }

  :global(.heading em) {
    color: var(--color-ocean);
    font-style: italic;
  }

  [data-theme="dark"] :global(.heading em) {
    color: var(--color-jade);
  }

  .description {
    font-size: clamp(13px, 1.3vw, 15px);
    color: var(--text-secondary);
    max-width: 58ch;
    line-height: 1.65;
  }
</style>
