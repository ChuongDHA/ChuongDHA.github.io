---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  target?: string;
  rel?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  ariaLabel?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  class: className = '',
  target,
  rel,
  type = 'button',
  disabled = false,
  ariaLabel,
} = Astro.props;

const classes = ['btn', `btn-${variant}`, `btn-size-${size}`, className].filter(Boolean).join(' ');
---

{href ? (
  <a
    href={href}
    class={classes}
    target={target}
    rel={rel}
    aria-label={ariaLabel}
  >
    <slot />
  </a>
) : (
  <button
    type={type}
    class={classes}
    disabled={disabled}
    aria-label={ariaLabel}
  >
    <slot />
  </button>
)}

<style>
  .btn-size-sm {
    padding: 0.5rem 1.125rem;
    font-size: 0.8125rem;
  }

  .btn-size-md {
    padding: 0.75rem 1.75rem;
    font-size: 0.9375rem;
  }

  .btn-size-lg {
    padding: 0.9375rem 2.25rem;
    font-size: 1.0625rem;
  }

  .btn-ghost {
    background: transparent;
    color: var(--color-ocean);
    border: none;
    padding-inline: 0.5rem;
  }

  .btn-ghost:hover {
    background: rgba(0, 129, 167, 0.08);
    box-shadow: none;
  }

  button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
  }
</style>
