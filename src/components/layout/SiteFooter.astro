---
import ArrowIcon from '@/components/ui/icons/ArrowIcon.astro';
import { portfolio } from '@/data/portfolio';

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <!-- Giant Watermark Monogram -->
  <div class="footer-wordmark" aria-hidden="true">CHA</div>

  <div class="container footer-content">
    <div class="footer-meta">
      <div class="footer-meta-block">
        <p class="footer-name">{portfolio.name}</p>
        <span class="footer-role">{portfolio.role}</span>
      </div>

      <div class="footer-meta-block">
        <p class="footer-school">{portfolio.institution}</p>
        <span class="footer-batch">Niên khóa {portfolio.academicYears}</span>
      </div>

      <div class="footer-meta-block footer-contact">
        <a href={`mailto:${portfolio.email}`} class="footer-email">
          {portfolio.email}
        </a>
        <a href="https://github.com/ChuongDHA" target="_blank" rel="noopener noreferrer" class="footer-github">
          GitHub <ArrowIcon diagonal />
        </a>
      </div>

      <div class="footer-meta-block footer-nav">
        <a href="/">Trang chủ <ArrowIcon /></a>
      </div>
    </div>

    <p class="footer-note">
      &copy; {currentYear} {portfolio.name} · Phân hiệu Cà Mau. Thiết kế theo phong cách Pop Art Portfolio, giữ nguyên bảng màu thương hiệu.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    overflow: hidden;
    padding: clamp(60px, 8vw, 100px) 0 35px;
    background: var(--color-ink);
    color: var(--color-white);
    margin-top: auto;
  }

  .footer-wordmark {
    color: var(--color-jade);
    font-family: var(--font-display);
    font-size: clamp(140px, 28vw, 420px);
    font-style: italic;
    font-weight: 800;
    letter-spacing: -0.14em;
    line-height: 0.65;
    text-align: center;
    text-shadow: 6px 8px 0 var(--color-ocean);
    transform: translateX(-1%);
    user-select: none;
    opacity: 0.88;
    pointer-events: none;
  }

  [data-theme="dark"] .footer-wordmark {
    color: var(--color-jade);
    text-shadow: 6px 8px 0 rgba(0, 129, 167, 0.5);
  }

  .footer-content {
    position: relative;
    z-index: 2;
  }

  .footer-meta {
    display: grid;
    grid-template-columns: 1.2fr 1.2fr 1.2fr auto;
    gap: 32px;
    align-items: end;
    margin-top: clamp(40px, 6vw, 70px);
    padding-top: 28px;
    border-top: 1px solid rgba(255, 255, 255, 0.22);
  }

  .footer-meta-block {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .footer-name,
  .footer-school {
    margin: 0;
    font-size: 13px;
    font-weight: 700;
    color: var(--color-white);
  }

  .footer-role,
  .footer-batch {
    color: rgba(255, 255, 255, 0.6);
    font-size: 11px;
    font-weight: 500;
  }

  .footer-email,
  .footer-github {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 600;
    color: var(--color-parchment);
    transition: color var(--transition-fast);
  }

  .footer-email:hover,
  .footer-github:hover {
    color: var(--color-jade);
  }

  .footer-nav a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-white);
    transition: color var(--transition-fast);
  }

  .footer-nav a:hover {
    color: var(--color-jade);
  }

  .footer-nav a :global(svg) {
    transform: rotate(-90deg);
  }

  .footer-note {
    margin: clamp(35px, 5vw, 50px) 0 0;
    color: rgba(255, 255, 255, 0.45);
    font-size: 10.5px;
    text-align: center;
    letter-spacing: 0.04em;
    line-height: 1.6;
  }

  @media (max-width: 900px) {
    .footer-meta {
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }

    .footer-nav {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 640px) {
    .footer-wordmark {
      font-size: 42vw;
      text-shadow: 4px 5px 0 var(--color-ocean);
    }

    .footer-meta {
      grid-template-columns: 1fr;
      gap: 20px;
      margin-top: 40px;
    }
  }
</style>
