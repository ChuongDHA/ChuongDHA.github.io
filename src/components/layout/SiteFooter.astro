---
import { portfolio } from '@/data/portfolio';
import { navigation } from '@/data/navigation';

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <!-- Decorative SVG wave -->
  <svg class="footer-wave" viewBox="0 0 1440 60" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <path d="M0 30 Q360 0 720 30 Q1080 60 1440 30 L1440 60 L0 60 Z" fill="var(--color-paper-deep)" opacity="0.5"/>
  </svg>

  <div class="container">
    <div class="footer-inner">
      <!-- Brand -->
      <div class="footer-brand">
        <a href="/" class="footer-monogram" aria-label="Trang chủ">
          <span>{portfolio.shortName}</span>
        </a>
        <p class="footer-tagline">
          {portfolio.headline || portfolio.role}
        </p>
      </div>

      <!-- Navigation -->
      <nav class="footer-nav" aria-label="Điều hướng footer">
        <ul role="list">
          {navigation.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </nav>

      <!-- Social links -->
      <div class="footer-social">
        <p class="footer-contact-label">Kết nối</p>
        <a href={`mailto:${portfolio.email}`} class="footer-email">
          {portfolio.email}
        </a>
        <div class="social-links">
          {portfolio.socialLinks.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="social-link"
              aria-label={link.label}
            >
              {link.label}
            </a>
          ))}
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="footer-copy">
        &copy; {currentYear} {portfolio.name}. Bảo lưu mọi quyền.
      </p>
      <a href="#site-header" class="back-to-top" aria-label="Lên đầu trang">
        ↑ Lên đầu
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-ink);
    color: rgba(255,255,255,0.75);
    padding-block: 3.5rem 2rem;
    margin-top: 0;
    position: relative;
  }

  .footer-wave {
    position: absolute;
    top: -29px;
    left: 0;
    width: 100%;
    max-width: 100%;
    height: 30px;
    pointer-events: none;
    display: block;
    overflow: hidden;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1.5fr;
    gap: 3rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid rgba(255,255,255,0.1);
  }

  /* Brand */
  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-monogram {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background: var(--gradient-primary);
    border-radius: 12px;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 500;
    color: white;
    text-decoration: none;
    letter-spacing: 0.05em;
    transition: transform var(--transition-base);
  }

  .footer-monogram:hover {
    transform: scale(1.05);
  }

  .footer-tagline {
    font-size: 0.9375rem;
    color: rgba(255,255,255,0.5);
    max-width: none;
    line-height: 1.5;
  }

  /* Footer nav */
  .footer-nav ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-nav a {
    color: rgba(255,255,255,0.6);
    font-size: 0.9375rem;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer-nav a:hover {
    color: var(--color-jade);
  }

  /* Social / contact */
  .footer-social {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-contact-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: rgba(255,255,255,0.35);
    margin-bottom: 0.25rem;
    max-width: none;
  }

  .footer-email {
    color: var(--color-parchment);
    font-size: 0.9375rem;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer-email:hover {
    color: var(--color-jade);
  }

  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  .social-link {
    padding: 0.35rem 0.875rem;
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 20px;
    color: rgba(255,255,255,0.6);
    font-size: 0.8125rem;
    text-decoration: none;
    transition: border-color var(--transition-fast), color var(--transition-fast), background var(--transition-fast);
  }

  .social-link:hover {
    border-color: var(--color-jade);
    color: var(--color-jade);
    background: rgba(0, 175, 185, 0.1);
  }

  /* Footer bottom */
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1.5rem;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .footer-copy {
    font-size: 0.8125rem;
    color: rgba(255,255,255,0.35);
    max-width: none;
  }

  .back-to-top {
    font-size: 0.8125rem;
    color: rgba(255,255,255,0.4);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .back-to-top:hover {
    color: var(--color-jade);
  }

  @media (max-width: 768px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .social-links {
      gap: 0.5rem;
    }
  }
</style>
