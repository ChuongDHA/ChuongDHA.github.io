---
import ArrowIcon from '@/components/ui/icons/ArrowIcon.astro';
import ThemeIcon from '@/components/ui/icons/ThemeIcon.astro';

const currentPath = Astro.url.pathname;

const navItems = [
  { label: 'Trang chủ', href: '/' },
  { label: 'Giới thiệu', href: '/about/' },
  { label: 'Nhật ký', href: '/post/' },
  { label: 'Liên hệ', href: '/contact/' },
];

function isCurrent(href: string) {
  const normCurrent = currentPath === '/' ? '/' : currentPath.replace(/\/+$/, '');
  const normHref = href === '/' ? '/' : href.replace(/\/+$/, '');
  if (normHref === '/') return normCurrent === '/';
  return normCurrent.startsWith(normHref);
}
---

<header class="site-header" id="site-header">
  <a class="brand" href="/" aria-label="CHA — về trang chủ">
    C<span>H</span>A
  </a>

  <nav id="site-nav" aria-label="Điều hướng chính">
    {navItems.map((item) => (
      <a
        href={item.href}
        class:list={[{ current: isCurrent(item.href) }]}
        aria-current={isCurrent(item.href) ? 'page' : undefined}
      >
        {item.label}
      </a>
    ))}
  </nav>

  <div class="header-tools">
    <button
      class="theme-button"
      id="theme-toggle"
      type="button"
      aria-label="Đổi chế độ sáng / tối"
      title="Đổi giao diện sáng / tối"
    >
      <ThemeIcon />
    </button>

    <a class="header-cta" href="/contact/">
      Let’s talk <ArrowIcon diagonal />
    </a>

    <button
      class="menu-button"
      id="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-label="Mở menu"
    >
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<script is:inline>
  (function() {
    // Theme toggle handler
    const themeBtn = document.getElementById('theme-toggle');
    if (themeBtn) {
      themeBtn.addEventListener('click', function() {
        const isDark = document.documentElement.dataset.theme === 'dark';
        const next = isDark ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem('cha-theme', next);
        } catch (e) {}
      });
    }

    // Mobile menu handler
    const menuBtn = document.getElementById('menu-toggle');
    const nav = document.getElementById('site-nav');
    if (menuBtn && nav) {
      menuBtn.addEventListener('click', function() {
        const isOpen = nav.classList.toggle('nav-open');
        menuBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        menuBtn.setAttribute('aria-label', isOpen ? 'Đóng menu' : 'Mở menu');
      });

      // Close menu when clicking outside or pressing Escape
      document.addEventListener('click', function(e) {
        if (!nav.contains(e.target) && !menuBtn.contains(e.target) && nav.classList.contains('nav-open')) {
          nav.classList.remove('nav-open');
          menuBtn.setAttribute('aria-expanded', 'false');
          menuBtn.setAttribute('aria-label', 'Mở menu');
        }
      });

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && nav.classList.contains('nav-open')) {
          nav.classList.remove('nav-open');
          menuBtn.setAttribute('aria-expanded', 'false');
          menuBtn.setAttribute('aria-label', 'Mở menu');
        }
      });
    }
  })();
</script>
