---
import '../styles/global.css';
import { portfolio } from '@/data/portfolio';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  pubDate?: Date;
}

const {
  title,
  description = portfolio.seo.description,
  image = portfolio.seo.ogImage,
  type = 'website',
  pubDate,
} = Astro.props;

const siteTitle = title ? `${title} — ${portfolio.shortName}` : `${portfolio.name} — ${portfolio.role}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <!-- Primary meta -->
    <title>{siteTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={portfolio.name} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:site_name" content={portfolio.name} />

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    {type === 'article' && pubDate && (
      <meta property="article:published_time" content={pubDate.toISOString()} />
    )}

    <!-- Fonts: Be Vietnam Pro + Noto Serif via Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,400;0,500;0,600;1,400&family=Noto+Serif:ital,wght@0,400;0,500;1,400&display=swap"
      rel="stylesheet"
    />



    <!-- JSON-LD Person schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": portfolio.name,
      "url": Astro.site?.href,
      "email": portfolio.email,
      "sameAs": portfolio.socialLinks.map(l => l.href),
    })} />

    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={portfolio.name} href="/rss.xml" />
  </head>

  <body>
    <!-- Skip to content -->
    <a href="#main-content" class="skip-link">Bỏ qua đến nội dung chính</a>

    <slot />
  </body>
</html>
